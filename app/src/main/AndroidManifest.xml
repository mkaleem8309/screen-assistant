<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="BitAssist"
        android:theme="@style/Theme.ScreenAssistant"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Launcher entry — only job is the "set default assistant" shortcut button. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AssistantActivity"
            android:theme="@style/Theme.ScreenAssistant.Transparent"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- Lets the system launch this activity as the device's assistant:
                 selectable under Settings > Apps > Default apps > Digital assistant app,
                 and invoked by the platform's assist gesture/action (long-press home,
                 gesture-nav corner swipe, etc.) instead of only our own overlay swipe. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".CaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

    </application>
</manifest>
