<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required only because a VoiceInteractionService must ship a working
         RecognitionService to appear in the assistant picker (see
         AssistantRecognitionService) — we never actually record audio. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="BitAssist"
        android:theme="@style/Theme.ScreenAssistant"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Launcher entry — only job is the "set default assistant" shortcut button. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AssistantActivity"
            android:theme="@style/Theme.ScreenAssistant.Transparent"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask" />
        <!-- No ACTION_ASSIST intent filter anymore — this activity is only ever
             started internally, by AssistantSession, after the system hands us
             the screenshot. It's not itself the assistant entry point. -->

        <service
            android:name=".AssistantVoiceInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>

        <service
            android:name=".AssistantSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />

        <service
            android:name=".AssistantRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- Needed to put a copied screenshot on the clipboard as an image:
             the clipboard only accepts a content:// Uri, not a raw Bitmap. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
