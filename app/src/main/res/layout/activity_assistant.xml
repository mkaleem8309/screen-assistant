<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim">

    <ImageView
        android:id="@+id/captured_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@color/card_bg"
        android:visibility="gone" />

    <!-- Darkens the screenshot a bit (~20% black) so the buttons/text on top
         of it stay legible against any content. Purely visual — OCR still
         reads from the original, undimmed bitmap in CaptureHolder. -->
    <View
        android:id="@+id/dim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:visibility="gone" />

    <!-- Lens-style translation patches get added here at runtime, each one
         positioned over the OCR block it translates. -->
    <FrameLayout
        android:id="@+id/translation_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btn_target_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:fitsSystemWindows="true"
        android:padding="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:text="@string/translate_to_english"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/assistant_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/btn_search_screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="@drawable/pill_button_bg"
                android:text="@string/action_search"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_translate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="@drawable/pill_button_bg"
                android:text="@string/action_translate"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btn_copy_screenshot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:fitsSystemWindows="true"
        android:padding="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:text="@string/action_copy"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:visibility="gone" />
</FrameLayout>
